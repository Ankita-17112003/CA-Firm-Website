# Backend API base URL (must include /api)
VITE_API_URL=http://localhost:5000/api

# WhatsApp number in international format, digits only (e.g. 919876543210). Leave empty until you have the real number.
VITE_WHATSAPP_NUMBER=

# Public contact details shown in the footer and contact page. Replace with the firm's real details.
VITE_FIRM_EMAIL=
VITE_FIRM_PHONE=
VITE_FIRM_ADDRESS=

# Google Maps embed URL (the src value from Google Maps > Share > Embed a map). Leave empty until the office location is confirmed.
VITE_MAPS_EMBED_URL=
