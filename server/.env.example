# Server
PORT=5000
NODE_ENV=development

# MongoDB (local: mongodb://127.0.0.1:27017/ca-firm | Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ca-firm)
MONGODB_URI=mongodb://127.0.0.1:27017/ca-firm

# Allowed frontend origin(s) for CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173
